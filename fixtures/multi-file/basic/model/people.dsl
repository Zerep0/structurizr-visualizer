federationOperator = person "Federation Operator" "An operator responsible for managing the federation"
clubAdministrator = person "Club Administrator" "An administrator responsible for managing a club within the federation"
athlete = person "Athlete" "An athlete participating in the federation"
fan = person "Fan" "A fan of the federation and its athletes"
sponsor = person "Sponsor" "A sponsor supporting the federation and its athletes"
venueOperator = person "Venue Operator" "An operator responsible for managing the venues where events take place"
provider = person "Provider" "A provider of services or products to the federation, athletes, or fans"
financeOperator = person "Finance Operator" "An operator responsible for managing the financial aspects of the federation"
auditor = person "Auditor" "An auditor responsible for reviewing the financial records and operations of the federation"
