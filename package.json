{
    "name": "structurizr-visualizer-workspace",
    "description": "Base workspace package",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "license": "Apache-2.0",
    "homepage": "https://github.com/Zerep0/structurizr-visualizer#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Zerep0/structurizr-visualizer.git"
    },
    "bugs": {
        "url": "https://github.com/Zerep0/structurizr-visualizer/issues"
    },
    "packageManager": "pnpm@12.10.1",
    "engines": {
        "node": ">=22.12.0 <27"
    },
    "scripts": {
        "clean": "pnpm -r clean",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && pnpm -r build",
        "build:clean": "pnpm clean && pnpm build",
        "typecheck": "tsc -b tsconfig.build.json --pretty false",
        "test": "vitest run",
        "package:extension": "pnpm --filter vscode-structurizr-visualizer package",
        "langium:generate": "pnpm --filter structurizr-language langium:generate",
        "langium:watch": "pnpm --filter structurizr-language langium:watch"
    },
    "devDependencies": {
        "@types/node": "~22.20.5",
        "shx": "~0.4.0",
        "typescript": "~5.8.3",
        "vitest": "~5.0.3"
    }
}
